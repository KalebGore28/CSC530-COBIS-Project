table academic_standing {
  id varchar(10) [pk, not null]
  description varchar(255) [not null]
}

table account {
  id varchar(50) [pk, not null]
  account_id varchar(255) [not null]
  provider_id varchar(255) [not null]
  user_id varchar(50) [not null]
  access_token varchar(2048)
  refresh_token varchar(2048)
  id_token varchar(2048)
  access_token_expires_at datetime
  refresh_token_expires_at datetime
  scope varchar(255)
  created_at datetime [not null]
  updated_at datetime [not null]
}

table admit_codes {
  id varchar(10) [pk, not null]
  description varchar(255) [not null]
}

table colleges {
  id varchar(10) [pk, not null]
  description varchar(255) [not null]
}

table course_prefixes {
  id varchar(10) [pk, not null]
  department_id varchar(10)
  college_id varchar(10)
}

table courses {
  id varchar(100) [pk, not null]
  subject varchar(50) [not null]
  number int [not null]
  suffix varchar(50) [not null, default: '']
  title varchar(255) [not null]
  hours int [not null]
  last_updated datetime [not null, default: `NOW()`]
  department_id varchar(10)
  college_id varchar(10)

  indexes {
    (subject, number, suffix) [name: 'ux_courses_idx', unique]
  }
}

table departments {
  id varchar(10) [pk, not null]
  description varchar(255) [not null]
  college_id varchar(10)
}

table faculty {
  mnumber varchar(10) [pk, not null]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  college_id varchar(10)
  department_id varchar(10)
}

table instructional_methods {
  id varchar(10) [pk, not null]
  description varchar(255) [not null]
}

table part_of_term {
  id varchar(10) [pk, not null]
  description varchar(255) [not null]
}

table programs {
  id varchar(10) [pk, not null]
  description varchar(255) [not null]
  cip_code varchar(255)
  is_major boolean [not null, default: false]
  is_minor boolean [not null, default: false]
  has_concentration boolean [not null, default: false]
  is_discontinued boolean [not null, default: false]
  is_aacsb boolean [not null, default: false]
  department_id varchar(10)
  college_id varchar(10)
  last_updated datetime [not null, default: `NOW()`]
  coordinator varchar(10)
}

table registration_status {
  id varchar(10) [pk, not null]
  description varchar(255) [not null]
}

table roles {
  id int [pk, not null]
  name varchar(100) [not null]
}

table session {
  id varchar(50) [pk, not null]
  expires_at datetime [not null]
  token varchar(255) [not null, unique]
  created_at datetime [not null]
  updated_at datetime [not null]
  ip_address varchar(45)
  user_agent varchar(255)
  user_id varchar(50) [not null]
}

table student_academic_info {
  mnumber varchar(10) [not null]
  term_id varchar(10) [not null]
  year int [not null]
  admit_term_id varchar(10)
  admit_year int
  admit_id varchar(10)
  academic_standing_id varchar(10)
  msu_attempted_hours real
  msu_earned_hours real
  msu_quality_points real
  msu_gpa real
  overall_attempted_hours real
  overall_earned_hours real
  overall_quality_points real
  overall_gpa real

  indexes {
    (mnumber, term_id, year) [name: 'ux_student_academic_info_idx', unique]
  }
}

table student_advisors {
  mnumber varchar(10) [not null]
  term_id varchar(10) [not null]
  year int [not null]
  advisor_mnumber varchar(10) [not null]

  indexes {
    (mnumber, term_id, year) [name: 'ux_student_advisors_idx', unique]
  }
}

table student_courses {
  mnumber varchar(10) [not null]
  term_id varchar(10) [not null]
  year int [not null]
  part_of_term_id varchar(10)
  course_id varchar(100) [not null]
  course_section varchar(50) [not null]
  course_hours int [not null]
  course_level varchar(50)
  registration_status_id varchar(10)
  instructional_method_id varchar(10)
  instructor_mnumber varchar(10) [not null]
  last_attendance datetime
  midterm_grade varchar(50)
  final_grade varchar(50)

  indexes {
    (mnumber, term_id, year, course_id, course_section) [name: 'ux_student_courses_idx', unique]
  }
}

table student_programs {
  mnumber varchar(10) [not null]
  term_id varchar(10) [not null]
  year int [not null]
  type varchar(50) [not null]
  level varchar(50) [not null]
  program_id varchar(10) [not null]

  indexes {
    (mnumber, term_id, year, program_id) [name: 'ux_student_programs_idx', unique]
    
    
  }
}

table students {
  mnumber varchar(10) [pk, not null]
  first_name varchar(50) [not null]
  middle_name varchar(50)
  last_name varchar(50) [not null]
  suffix varchar(10)
  gender varchar(10)
  email varchar(100)
}

table terms {
  id varchar(10) [pk, not null]
  description varchar(255) [not null]
}

table user {
  id varchar(50) [pk, not null]
  mnumber varchar(10) [unique]
  name varchar(50) [not null]
  email varchar(100) [not null, unique]
  email_verified boolean [not null]
  image varchar(255) [not null, default: '']
  created_at datetime [not null]
  updated_at datetime [not null]
  last_login datetime
  is_enabled boolean [not null, default: false]
}

table user_roles {
  user_id varchar(50) [not null]
  role_id int [not null]

  indexes {
    (user_id, role_id) [name: 'ux_user_roles_idx', unique]
  }
}

table verification {
  id varchar(50) [pk, not null]
  identifier varchar(255) [not null]
  value varchar(2048) [not null]
  expires_at datetime [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}