# Node.js and build artifacts
node_modules
npm-debug.log

# Source code (not needed in production, already bundled in dist/)
src/
src/**/*
src/**/**/*
src/**/**/**/*

# TypeScript and build config
tsconfig.json
tsconfig.tsbuildinfo
vitest.config.ts

# Dev tools and scripts
esbuild.config.js

# Tests
tests/
tests/**/*
tests/**/**/*
tests/**/**/**/*

# Seed data (handled externally)
seed/
seed/**/*
seed/**/**/*
seed/**/**/**/*

# Fonts and other assets (not needed unless explicitly used in production)
fonts/
fonts/**/*
fonts/**/**/*
fonts/**/**/**/*

# Temporary files and logs
*.log

# Environment files (handled via env vars or secrets)
.env
.env.*

# Git and IDE files
.git
.gitignore
.DS_Store
*.swp
*.swo

# DB files (handled via volume, not in image)
prod.sqlite3
src/db/dev.sqlite3
dist/db/
dist/db/**/*
dist/db/**/**/*
dist/db/**/**/**/*