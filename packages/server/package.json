{
	"name": "cobis-server",
	"type": "module",
	"version": "1.0.0",
	"scripts": {
		"dev": "npx nodemon --exec tsx src/index.ts",
		"db:push": "drizzle-kit push && tsx src/db/dbml.ts",
		"db:generate": "drizzle-kit generate && tsx src/db/dbml.ts",
		"db:migrate": "drizzle-kit migrate && tsx src/db/dbml.ts",
		"db:reset": "rm -f src/db/dev.sqlite3 && drizzle-kit push && tsx src/db/dbml.ts",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx src/seed/seed.ts",
		"db:seedgen": "tsx src/seed/seedgen.ts"
	},
	"dependencies": {
		"@apollo/server": "^5.0.0",
		"@as-integrations/express5": "^1.1.2",
		"@faker-js/faker": "^9.9.0",
		"better-auth": "^1.2.12",
		"better-sqlite3": "^12.2.0",
		"cors": "^2.8.5",
		"dataloader": "^2.2.3",
		"dotenv": "^17.1.0",
		"drizzle-orm": "^0.44.2",
		"express": "^5.1.0",
		"graphql": "^16.11.0",
		"mysql2": "^3.14.1",
		"papaparse": "^5.5.3",
		"zod": "^3.25.75"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/node": "^24.0.10",
		"@types/supertest": "^6.0.3",
		"drizzle-dbml-generator": "^0.10.0",
		"drizzle-kit": "^0.31.4",
		"nodemon": "^3.1.10",
		"supertest": "^7.1.3",
		"tsx": "^4.20.3"
	}
}