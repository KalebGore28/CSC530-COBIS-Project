{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"incremental": true,
		"rootDir": "./src",
		"resolveJsonModule": true,
		"allowJs": true,
		"sourceMap": true,
		"outDir": "./dist",
		"inlineSources": true
	},
	"include": [
		"src/**/*",
		"src/index.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}