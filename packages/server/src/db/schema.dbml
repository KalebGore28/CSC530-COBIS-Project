table academic_standing {
  code varchar(50) [pk, not null]
  description varchar(255) [not null]
}

table account {
  id varchar(50) [pk, not null]
  account_id varchar(255) [not null]
  provider_id varchar(255) [not null]
  user_id varchar(50) [not null]
  access_token varchar(255)
  refresh_token varchar(255)
  id_token varchar(2048)
  access_token_expires_at datetime
  refresh_token_expires_at datetime
  scope varchar(255)
  created_at datetime [not null]
  updated_at datetime [not null]
}

table admit_codes {
  code varchar(50) [pk, not null]
  description varchar(255) [not null]
}

table colleges {
  code varchar(50) [pk, not null]
  description varchar(255) [not null]
}

table course_prefixes {
  prefix varchar(50) [pk, not null]
  department varchar(50) [not null]
  college varchar(50) [not null]
}

table courses {
  subject varchar(50) [not null]
  number int [not null]
  suffix varchar(50) [not null, default: '']
  title varchar(255) [not null]
  hours int [not null]
  fee real [not null, default: 0]
  web_fee real [not null, default: 0]
  last_updated datetime [not null, default: `NOW()`]
  department varchar(50) [default: '0000']
  college varchar(50) [default: '0']

  indexes {
    (subject, number, suffix) [pk]
  }
}

table departments {
  code varchar(50) [pk, not null]
  description varchar(255) [not null]
  college varchar(50) [not null, default: '0']
}

table faculty {
  mnumber varchar(10) [pk, not null]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  college varchar(50) [default: '0']
  department varchar(50) [default: '0000']
}

table instructional_methods {
  code varchar(50) [pk, not null]
  description varchar(255) [not null]
}

table instructor_courses {
  mnumber varchar(10) [not null]
  term varchar(50) [not null]
  year int [not null]
  crn varchar(50) [not null]
  course_subject varchar(50) [not null]
  course_number int [not null]
  course_suffix varchar(50) [not null, default: '']
  course_section varchar(50) [not null, default: '']
  role varchar(50) [not null, default: 'Instructor']

  indexes {
    (mnumber, term, year, crn) [pk]
    
  }
}

table nations {
  code varchar(50) [pk, not null]
  description varchar(255) [not null]
}

table part_of_term {
  code varchar(50) [pk, not null]
  description varchar(255) [not null]
}

table programs {
  code varchar(10) [pk, not null]
  description varchar(255) [not null]
  cip_code varchar(255)
  is_major boolean [not null, default: false]
  is_minor boolean [not null, default: false]
  has_concentration boolean [not null, default: false]
  is_discontinued boolean [not null, default: false]
  is_aacsb boolean [not null, default: false]
  department varchar(50) [not null]
  college varchar(50) [not null]
  added_on datetime [not null, default: `NOW()`]
}

table registration_status {
  code varchar(50) [pk, not null]
  description varchar(255) [not null]
}

table roles {
  id int [pk, not null]
  name varchar(100) [not null]
}

table session {
  id varchar(50) [pk, not null]
  expires_at datetime [not null]
  token varchar(255) [not null, unique]
  created_at datetime [not null]
  updated_at datetime [not null]
  ip_address varchar(45)
  user_agent varchar(255)
  user_id varchar(50) [not null]
}

table student_academic_info {
  mnumber varchar(10) [not null]
  term varchar(50) [not null]
  year int [not null]
  admit_term varchar(50) [not null]
  admit_year int [not null]
  admit_code varchar(50) [not null]
  academic_standing varchar(50) [not null]
  msu_attempted_hours real [not null]
  msu_earned_hours real [not null]
  msu_quality_points real [not null]
  msu_gpa real [not null]
  overall_attempted_hours real [not null]
  overall_earned_hours real [not null]
  overall_quality_points real [not null]
  overall_gpa real [not null]

  indexes {
    (mnumber, term, year) [pk]
  }
}

table student_addresses {
  mnumber varchar(10) [not null]
  type varchar(50) [not null]
  street1 varchar(100) [not null]
  street2 varchar(100)
  city varchar(50) [not null]
  state varchar(50) [not null]
  zip varchar(10) [not null]
  nation varchar(50) [not null]
  phone varchar(15) [not null]

  indexes {
    (mnumber, type) [pk]
    
  }
}

table student_advisors {
  student_mnumber varchar(10) [not null]
  term varchar(50) [not null]
  year int [not null]
  advisor_mnumber varchar(10) [not null]

  indexes {
    (student_mnumber, term, year, advisor_mnumber) [pk]
  }
}

table student_courses {
  mnumber varchar(10) [not null]
  term varchar(50) [not null]
  year int [not null]
  part_of_term varchar(50) [not null]
  crn varchar(50) [not null]
  course_subject varchar(50) [not null]
  course_number int [not null]
  course_suffix varchar(50) [not null, default: '']
  course_section varchar(50) [not null]
  course_hours int [not null]
  course_level varchar(50) [not null]
  registration_status varchar(50) [not null]
  instructional_method varchar(50) [not null]
  last_attendance varchar(50)
  midterm_grade varchar(50)
  final_grade varchar(50)

  indexes {
    (mnumber, term, year, crn) [pk]
    
  }
}

table student_programs {
  mnumber varchar(10) [not null]
  term varchar(50) [not null]
  year int [not null]
  type varchar(50) [not null]
  level varchar(50) [not null]
  program varchar(50) [not null]

  indexes {
    (mnumber, type, program) [pk]
    
    
  }
}

table students {
  mnumber varchar(10) [pk, not null]
  first_name varchar(50) [not null]
  middle_name varchar(50) [not null]
  last_name varchar(50) [not null]
  suffix varchar(10) [not null]
  gender varchar(10) [not null]
  birthdate varchar(10) [not null]
  citizenship varchar(50) [not null]
  race_code varchar(50) [not null]
  race_description varchar(50) [not null]
  residency_code varchar(50) [not null]
  residency_description varchar(50) [not null]
  age int [not null]
  cell_phone varchar(15) [not null]
  email varchar(100) [not null]
}

table terms {
  code varchar(10) [pk, not null]
  description varchar(255) [not null]
}

table user {
  id varchar(50) [pk, not null]
  mnumber varchar(10) [unique]
  name varchar(50) [not null]
  email varchar(100) [not null, unique]
  email_verified boolean [not null]
  image varchar(255) [not null, default: '']
  created_at datetime [not null]
  updated_at datetime [not null]
  is_enabled boolean [not null, default: false]
  last_login datetime
}

table user_roles {
  user_id varchar(50) [not null]
  role_id int [not null]

  indexes {
    (user_id, role_id) [pk]
  }
}

table verification {
  id varchar(50) [pk, not null]
  identifier varchar(255) [not null]
  value varchar(255) [not null]
  expires_at datetime [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}

ref: departments.college > colleges.code

ref: faculty.college > colleges.code

ref: faculty.department > departments.code

ref: instructor_courses.mnumber - faculty.mnumber

ref: instructor_courses.(course_subject, course_number, course_suffix) > courses.(subject, number, suffix)

ref: instructor_courses.term > terms.code

ref: programs.college > colleges.code

ref: programs.department > departments.code

ref: student_academic_info.mnumber > students.mnumber

ref: student_academic_info.admit_term > terms.code

ref: student_academic_info.admit_code > admit_codes.code

ref: student_academic_info.academic_standing > academic_standing.code

ref: student_addresses.mnumber > students.mnumber

ref: student_addresses.nation > nations.code

ref: student_advisors.student_mnumber > students.mnumber

ref: student_advisors.term > terms.code

ref: student_courses.mnumber > students.mnumber

ref: student_courses.term > terms.code

ref: student_courses.part_of_term > part_of_term.code

ref: student_courses.(course_subject, course_number, course_suffix) > courses.(subject, number, suffix)

ref: student_courses.registration_status > registration_status.code

ref: student_courses.instructional_method > instructional_methods.code

ref: student_programs.mnumber > students.mnumber

ref: student_programs.term > terms.code

ref: student_programs.program > programs.code

ref: user_roles.user_id > user.id

ref: user_roles.role_id > roles.id