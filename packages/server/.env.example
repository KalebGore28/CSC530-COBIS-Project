# This env is used only for local dev builds.
# So running `npm run start` will use this env.

## --- FRONTEND ENVIRONMENT VARIABLES ---

# Frontend environment variables are located in the main directory of the app package.

# Environment variables
NODE_ENV=development

# Database Connection (REQUIRED)
DB_HOST=hostname #(e.g., localhost or an IP address)
DB_PORT=3306
DB_USER=dev
DB_PASSWORD=dev-password
DB_NAME=cobis

# Google SSO
GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com # Replace with your actual client ID
GOOGLE_CLIENT_SECRET=test-client-secret # Replace with your actual client secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/callback/google # Good for local development

# BetterAuth (In production, the frontend and backend should be on the same origin)
FRONTEND_ORIGIN=http://localhost:5173 # Used for Trusted Origin in better-auth
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=your-better-auth-secret # Replace with your actual secret in production

PORT=8080