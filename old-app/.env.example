# This env is used only for local production builds.
# So running `npm run start` will use this env.

## --- FRONTEND ENVIRONMENT VARIABLES ---

# Frontend variables are baked into the build.
# This is Vite's way of handling environment variables in bundled applications.

## --- BACKEND ENVIRONMENT VARIABLES ---
NODE_ENV=production

# Database Connection (REQUIRED)
DB_HOST=hostname #(e.g., localhost or an IP address) host.docker.internal for Docker Build on Mac. Windows untested.
DB_PORT=3306
DB_USER=cobis-app
DB_PASSWORD=secret-app-password
DB_NAME=cobis

# Google SSO
GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com # Replace with your actual client ID
GOOGLE_CLIENT_SECRET=test-client-secret # Replace with your actual client secret
GOOGLE_CALLBACK_URL=https://cobis-app.com/api/auth/callback/google # Replace origin with your actual origin

# BetterAuth (In production, the frontend and backend should be on the same origin)
FRONTEND_ORIGIN=https://cobis-app.com # Replace with your actual origin
BETTER_AUTH_URL=https://cobis-app.com # Replace with your actual origin
BETTER_AUTH_SECRET=your-better-auth-secret # Replace with your actual secret in production

PORT=8080