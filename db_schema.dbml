Table permissions {
  permission_id int           [pk, increment]
  table_name    nvarchar(100) [not null, note: "Which table the permission applies to"]
  column_name   nvarchar(100)
  can_read      bit           [default: 0, note: "Read access (BOOLEAN -> BIT Fix)"]
  can_write     bit           [default: 0, note: "Write access (BOOLEAN -> BIT Fix)"]
  description   nvarchar(255) [note: "Short explanation for admin UI"]
}

Table role_permissions {
