{
  "name": "cobis-app",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "db:gen": "drizzle-kit generate && tsx src/db/dbml.ts",
