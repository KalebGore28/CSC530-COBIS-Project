# Ignore node_modules (installed inside the container)
node_modules/

# Ignore esbuild output (will be rebuilt)
dist/

# Ignore local environment files
.env
.env.local

# Ignore editor config and logs
.vscode/
.idea/
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore Git repository files
.git/
.gitignore

# Ignore test files and documentation (if not needed)
tests/
docs/
coverage/