        "@tanstack/react-query": "^5.90.20",
        "@tanstack/react-query-devtools": "^5.91.3",
        "@tanstack/react-router": "^1.159.3",
        "@tanstack/react-router-devtools": "^1.159.3",
        "@tanstack/react-router-ssr-query": "^1.159.3",
        "@tanstack/react-start": "^1.159.3",
