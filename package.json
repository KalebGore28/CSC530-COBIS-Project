{
  "name": "cobis-monorepo",
  "type": "module",
  "version": "1.0.2",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node --env-file=.env dist/server.js",
    "relay": "npm run relay --workspace=cobis-app",
    "dev": "concurrently \"npm run dev --workspace=cobis-app\" \"npm run dev --workspace=cobis-server\"",
    "build": "node esbuild.config.js",
    "db:push": "npm run db:push --workspace=cobis-server",
    "db:generate": "npm run db:generate --workspace=cobis-server",
    "db:migrate": "npm run db:migrate --workspace=cobis-server",
    "db:reset": "npm run db:reset --workspace=cobis-server",
    "db:studio": "npm run db:studio --workspace=cobis-server",
    "db:seed": "npm run db:seed --workspace=cobis-server",
    "db:seedgen": "npm run db:seedgen --workspace=cobis-server",
    "docker:build": "docker build -t cobis-app .",
    "docker:run": "docker run -p 8080:8080 -d --name cobis-app --network cobis-network --env-file .env cobis-app"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "better-auth": "^1.3.18"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.10",
    "esbuild-plugin-copy": "^2.1.1",
    "typescript": "~5.9.2"
  },
  "not-finished-scripts": {
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  }
}
