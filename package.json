{
  "name": "cobis-app",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "NODE_ENV=production vp build",
    "preview": "bun --bun vp preview",
    "serve": "bun .output/server/index.mjs",
    "test": "vp test run",
    "lint": "vp lint --type-aware",
    "lint:fix": "vp lint --type-aware --fix",
    "format": "vp fmt",
    "check": "vp fmt . && vp lint --type-aware",
    "db:gen": "drizzle-kit generate",
    "db:mig": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed/deploy.ts",
    "db:make-admin": "tsx db/seed/make-admin.ts",
    "db:seed-demo": "tsx db/seed/demo.ts",
    "docker:build": "docker build -t cobis-app:latest .",
    "docker:run": "docker run -d --env-file .env.docker -p 3000:3000 cobis-app:latest",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/query-db-collection": "1.4.8",
    "@tanstack/react-db": "^0.5.12",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-router-with-db": "^1.0.0-rc.1",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "lucide-react": "^1.66.0",
    "mysql2": "^3.24.6",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/react-devtools": "^0.10.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "drizzle-seed": "^1.0.0-rc.5-ab785fc",
    "jsdom": "^30.1.3",
    "shadcn": "^4.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  }
}
