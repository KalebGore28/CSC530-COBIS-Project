        "@types/node": "^25.0.3",
        "@types/papaparse": "^5.5.2",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "drizzle-dbml-generator": "^0.10.0",
        "drizzle-kit": "1.0.0-beta.5-e0482ac",
        "jsdom": "^27.3.0",
        "prettier": "^3.7.4",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.0",
        "vitest": "^4.0.16"
    }
}
