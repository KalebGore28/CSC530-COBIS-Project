{
    "name": "cobis-app",
    "private": true,
    "type": "module",
    "version": "0.5.0",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "serve": "vite preview",
        "test": "vitest run",
        "lint": "eslint",
        "format": "prettier",
        "check": "prettier --write . && eslint --fix",
        "db:gen": "drizzle-kit generate && tsx src/db/dbml.ts",
        "db:mig": "drizzle-kit migrate && tsx src/db/dbml.ts",
        "db:studio": "drizzle-kit studio",
        "db:seed": "tsx src/db/seed/seed.ts",
        "db:new-seed": "tsx test/helpers/seed.ts",
        "docker:build": "docker build -t cobis-app:latest .",
        "docker:run": "docker run -d --env-file .env.docker -p 3000:3000 cobis-app:latest"
    },
    "dependencies": {
        "@radix-ui/react-avatar": "^1.1.11",
