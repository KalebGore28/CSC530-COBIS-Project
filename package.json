        "radix-ui": "^1.4.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-intersection-observer": "^10.0.2",
        "recharts": "3.7.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
