{
    "name": "cobis-app",
    "private": true,
    "type": "module",
    "version": "1.2.1",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "serve": "vite preview",
        "test": "vitest run",
        "lint": "eslint",
        "format": "prettier",
        "check": "prettier --write . && eslint --fix",
        "db:gen": "drizzle-kit generate && tsx src/db/dbml.ts",
        "db:mig": "drizzle-kit migrate && tsx src/db/dbml.ts",
        "db:studio": "drizzle-kit studio",
        "db:seed": "tsx src/db/seed/seed.ts",
        "db:new-seed": "tsx test/helpers/seed.ts",
        "docker:build": "docker build -t cobis-app:latest .",
        "docker:run": "docker run -d --env-file .env.docker -p 3000:3000 cobis-app:latest"
    },
    "dependencies": {
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slider": "^1.3.6",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/query-broadcast-client-experimental": "^5.90.12",
        "@tanstack/query-db-collection": "^1.0.12",
        "@tanstack/react-db": "^0.1.60",
        "@tanstack/react-query": "^5.90.12",
        "@tanstack/react-query-devtools": "^5.91.1",
        "@tanstack/react-router": "^1.143.3",
        "@tanstack/react-router-devtools": "^1.143.3",
        "@tanstack/react-router-ssr-query": "^1.143.3",
        "@tanstack/react-start": "^1.143.3",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/router-plugin": "^1.143.3",
        "better-auth": "^1.4.9",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.1.0",
        "dotenv": "^17.2.3",
        "drizzle-orm": "1.0.0-beta.5-e0482ac",
        "drizzle-seed": "1.0.0-beta.5-e0482ac",
        "file-saver": "^2.0.5",
        "lucide-react": "^0.562.0",
        "mysql2": "^3.16.0",
        "next-themes": "^0.4.6",
        "papaparse": "^5.5.3",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "react-intersection-observer": "^10.0.0",
        "recharts": "^3.6.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.18",
        "tw-animate-css": "^1.4.0",
        "vaul": "^1.1.2",
        "vite-tsconfig-paths": "^6.0.3",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@tanstack/eslint-config": "^0.3.4",
        "@tanstack/eslint-plugin-query": "^5.91.2",
