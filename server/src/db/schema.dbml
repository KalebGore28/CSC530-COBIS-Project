table academic_standing {
  code text [pk, not null]
  description text [not null]
}

table account {
  id text [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at integer
  refresh_token_expires_at integer
  scope text
  password text
  created_at integer [not null]
  updated_at integer [not null]
}

table admit_codes {
  code text [pk, not null]
  description text [not null]
}

table college_codes {
  code text [pk, not null]
  description text [not null]
}

table colleges {
  code text [pk, not null]
  description text [not null]
}

table courses {
  subject text [not null]
  number integer [not null]
  suffix text [not null, default: '']
  title text [not null]
  hours integer [not null]
  fee real [not null, default: 0]
  web_fee real [not null, default: 0]
  last_updated text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (subject, number, suffix) [pk]
  }
}

table departments {
  code text [pk, not null]
  description text [not null]
  prefixes text
  canvas_id text
  college text [not null, default: '0']
}

table imports {
  id integer [pk, not null]
  entity_type text [not null]
  file_name text [not null]
  total_records integer [not null]
  error_details text [not null]
  import_status text [not null]
  imported_by text [not null]
  import_date text [not null, default: `CURRENT_TIMESTAMP`]
}

table instructional_methods {
  code text [pk, not null]
  description text [not null]
}

table instructor_courses {
  instructor_mnumber text [not null]
  term text [not null]
  year integer [not null]
  crn text [not null]
  course_subject text [not null]
  course_number text [not null]
  course_suffix text [not null, default: '']
  role text [not null, default: 'Instructor']

  indexes {
    (instructor_mnumber, term, crn) [pk]
    
  }
}

table nations {
  code text [pk, not null]
  description text [not null]
}

table overrides {
  mnumber text [not null]
  term text [not null]
  year integer [not null]
  crn text [not null]
  subject text [not null]
  number text [not null]
  suffix text [not null, default: '']
  section text [not null]
  override_type text [not null]
  granted_by text [not null]
  override_date text [not null]

  indexes {
    (mnumber, term, year, crn) [pk]
    
  }
}

table part_of_term {
  code text [pk, not null]
  description text [not null]
}

table permissions {
  table_name text [not null]
  column_name text [not null]

  indexes {
    (table_name, column_name) [pk]
  }
}

table previous_colleges {
  mnumber text [not null]
  college_code text [not null]
  college_description text [not null]
  degree text [not null]
  date text [not null]

  indexes {
    (mnumber, college_code) [pk]
  }
}

table programs {
  code text [pk, not null]
  description text [not null]
  cip_code text
  is_major integer [not null, default: false]
  is_minor integer [not null, default: false]
  has_concentration integer [not null, default: false]
  is_discontinued integer [not null, default: false]
  is_aacsb integer [not null, default: false]
  department text [not null]
  college text [not null]
  added_on text [not null, default: `CURRENT_TIMESTAMP`]
}

table registration_status {
  code text [pk, not null]
  description text [not null]
}

table role_permissions {
  role_id integer [not null]
  table_name text [not null]
  column_name text [not null]

  indexes {
    (role_id, table_name, column_name) [pk]
    
  }
}

table roles {
  id integer [pk, not null]
  name text [not null]
}

table session {
  id text [pk, not null]
  expires_at integer [not null]
  token text [not null, unique]
  created_at integer [not null]
  updated_at integer [not null]
  ip_address text
  user_agent text
  user_id text [not null]
}

table student_academic_info {
  mnumber text [pk, not null]
  admit_term text [not null]
  admit_year integer [not null]
  admit_code text [not null]
  academic_standing text [not null]
  msu_attempted_hours real [not null]
  msu_earned_hours real [not null]
  msu_quality_points real [not null]
  msu_gpa real [not null]
  overall_attempted_hours real [not null]
  overall_earned_hours real [not null]
  overall_quality_points real [not null]
  overall_gpa real [not null]
}

table student_addresses {
  mnumber text [not null]
  type text [not null]
  street1 text [not null]
  street2 text
  city text [not null]
  state text [not null]
  zip text [not null]
  nation_code text [not null]
  phone text [not null]

  indexes {
    (mnumber, type) [pk]
    
  }
}

table student_advisors {
  student_mnumber text [not null]
  term text [not null]
  year integer [not null]
  advisor_mnumber text [not null]

  indexes {
    (student_mnumber, term, year, advisor_mnumber) [pk]
  }
}

table student_courses {
  mnumber text [not null]
  term text [not null]
  year integer [not null]
  part_of_term text [not null]
  crn text [not null]
  course_subject text [not null]
  course_number text [not null]
  course_suffix text [not null]
  course_section text [not null]
  course_hours integer [not null]
  course_level text [not null]
  registration_status text [not null]
  instructional_method text [not null]
  last_attendance text
  midterm_grade text
  final_grade text

  indexes {
    (mnumber, term, year, crn) [pk]
    
  }
}

table student_programs {
  mnumber text [not null]
  term text [not null]
  year integer [not null]
  type text [not null]
  level text [not null]
  program text [not null]
  department text [not null]
  college text [not null]

  indexes {
    (mnumber, type, program) [pk]
    
    
  }
}

table students {
  mnumber text [pk, not null]
  first_name text [not null]
  middle_name text [not null]
  last_name text [not null]
  suffix text [not null]
  gender text [not null]
  birthdate text [not null]
  citizenship text [not null]
  race_code text [not null]
  race_description text [not null]
  residency_code text [not null]
  residency_description text [not null]
  age integer [not null]
  cell_phone text [not null]
}

table terms {
  code text [pk, not null]
  description text [not null]
}

table test_scores {
  mnumber text [not null]
  code text [not null]
  description text [not null]
  score real [not null]
  date text [not null]

  indexes {
    (mnumber, code, date) [pk]
  }
}

table user {
  id text [pk, not null]
  mnumber text [unique]
  name text [not null]
  email text [not null, unique]
  email_verified integer [not null]
  college text
  department text
  image text
  created_at integer [not null]
  updated_at integer [not null]
  is_enabled integer [not null, default: false]
  last_login integer [not null, default: `CURRENT_TIMESTAMP`]
}

table user_permissions {
  user_id text [not null]
  table_name text [not null]
  column_name text [not null]

  indexes {
    (user_id, table_name, column_name) [pk]
    
  }
}

table user_roles {
  user_id text [not null]
  role_id integer [not null]

  indexes {
    (user_id, role_id) [pk]
  }
}

table verification {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at integer [not null]
  created_at integer
  updated_at integer
}

ref: colleges.code > user.college

ref: departments.college > colleges.code

ref: departments.code > user.department

ref: imports.imported_by > user.id

ref: instructor_courses.instructor_mnumber > user.mnumber

ref: instructor_courses.(course_subject, course_number, course_suffix) > courses.(subject, number, suffix)

ref: instructor_courses.term > terms.code

ref: overrides.mnumber > students.mnumber

ref: overrides.(subject, number, suffix) > courses.(subject, number, suffix)

ref: overrides.term > terms.code

ref: previous_colleges.college_code > college_codes.code

ref: previous_colleges.mnumber > students.mnumber

ref: programs.college > colleges.code

ref: programs.department > departments.code

ref: role_permissions.role_id > roles.id

ref: role_permissions.(table_name, column_name) > permissions.(table_name, column_name)

ref: student_academic_info.mnumber > students.mnumber

ref: student_academic_info.admit_term > terms.code

ref: student_academic_info.admit_code > admit_codes.code

ref: student_academic_info.academic_standing > academic_standing.code

ref: student_addresses.mnumber > students.mnumber

ref: student_addresses.nation_code > nations.code

ref: student_advisors.student_mnumber > students.mnumber

ref: student_advisors.term > terms.code

ref: student_courses.mnumber > students.mnumber

ref: student_courses.term > terms.code

ref: student_courses.part_of_term > part_of_term.code

ref: student_courses.(course_subject, course_number, course_suffix) > courses.(subject, number, suffix)

ref: student_courses.registration_status > registration_status.code

ref: student_courses.instructional_method > instructional_methods.code

ref: student_programs.mnumber > students.mnumber

ref: student_programs.term > terms.code

ref: student_programs.program > programs.code

ref: student_programs.department > departments.code

ref: student_programs.college > colleges.code

ref: test_scores.mnumber > students.mnumber

ref: user_permissions.user_id > user.id

ref: user_permissions.(table_name, column_name) > permissions.(table_name, column_name)

ref: user_roles.user_id > user.id

ref: user_roles.role_id > roles.id