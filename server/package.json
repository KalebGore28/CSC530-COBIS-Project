{
	"type": "module",
	"name": "cobis-server",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"dev": "npx nodemon --exec tsx src/index.ts",
		"test": "vitest --coverage",
		"build": "node esbuild.config.js",
		"db:push": "drizzle-kit push && tsx src/db/dbml.ts",
		"db:generate": "drizzle-kit generate && tsx src/db/dbml.ts",
		"db:migrate": "drizzle-kit migrate && tsx src/db/dbml.ts",
		"db:reset": "rm -f src/db/dev.sqlite3 && drizzle-kit push && tsx src/db/dbml.ts",
		"db:seed": "tsx src/seed/seed.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@scalar/express-api-reference": "^0.6.1",
		"better-auth": "^1.2.4",
		"better-sqlite3": "^11.8.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"drizzle-orm": "^0.40.0",
		"express": "^4.21.2",
		"jsonwebtoken": "^9.0.2",
		"multer": "^1.4.5-lts.1",
		"passport": "^0.7.0",
		"passport-google-oauth20": "^2.0.0",
		"pdfmake": "^0.2.18",
		"typescript": "^5.7.3",
		"zod": "^3.24.2",
		"zod-openapi": "^4.2.3"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.12",
		"@types/cookie-parser": "^1.4.8",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/multer": "^1.4.12",
		"@types/node": "^22.13.5",
		"@types/passport": "^1.0.17",
		"@types/passport-google-oauth20": "^2.0.16",
		"@types/supertest": "^6.0.2",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"@vitest/coverage-v8": "^3.0.7",
		"axios": "^1.8.1",
		"csv-parser": "^3.2.0",
		"drizzle-dbml-generator": "^0.10.0",
		"drizzle-kit": "^0.30.5",
		"esbuild": "^0.25.0",
